# Copy to .env and fill in. Never commit .env.
# Provider key used server side. The phone never sees it.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Comma separated shared secrets. Put one in the app under Settings > AI > Proxy token.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
PROXY_TOKENS=

# Requests per minute allowed per token.
RATE_LIMIT_PER_MIN=30
