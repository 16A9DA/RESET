# Copy to .env (here or in the repo root) and fill in. Never commit .env.
# Pick the provider. If unset, whichever key below is present is used (Anthropic first).
AI_PROVIDER=anthropic

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# OpenAI. There is no default model on purpose: choose a vision capable one from your account.
OPENAI_API_KEY=
OPENAI_MODEL=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Required. Comma separated shared secrets. Put one in the app under Settings > AI > Backend proxy.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
PROXY_TOKENS=

# Requests per minute allowed per token.
RATE_LIMIT_PER_MIN=30
